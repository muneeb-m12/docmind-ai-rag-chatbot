PORT=5000
MONGODB_URI=
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
CLIENT_URL=http://localhost:5173
# Leave MONGODB_URI empty to run with the in-memory store (zero-config demo).
# Leave OPENAI_API_KEY empty to run with local fallback embeddings + extractive answers.
